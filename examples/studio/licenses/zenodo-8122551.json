{"created": "2023-07-07T00:19:15.597901+00:00", "modified": "2024-07-11T18:35:13.735605+00:00", "id": 8122551, "conceptrecid": "8122550", "doi": "10.21437/Interspeech.2020-2800", "doi_url": "https://doi.org/10.21437/Interspeech.2020-2800", "metadata": {"title": "DiPCo -- Dinner Party Corpus", "doi": "10.21437/Interspeech.2020-2800", "publication_date": "2020-07-25", "description": "<p>We present a speech data corpus that simulates a &quot;dinner party&quot; scenario taking place in an everyday home environment. The corpus was created by recording multiple groups of four Amazon employee volunteers having a natural conversation in English around a dining table. The participants were recorded by a single-channel close-talk microphone and by five far-field 7-microphone array devices positioned at different locations in the recording room. The dataset contains the audio recordings and human labeled transcripts of a total of 10 sessions with a duration between 15 and 45 minutes. The corpus was created to advance in the field of noise robust and distant speech processing and is intended to serve as a public research and benchmarking data set.<br>\n&nbsp;</p>", "access_right": "open", "creators": [{"name": "Van Segbroeck, Maarten", "affiliation": "Amazon"}, {"name": "Zaid, Ahmed", "affiliation": "Amazon"}, {"name": "Kutsenko, Ksenia", "affiliation": "Amazon"}, {"name": "Huerta, Cirenia", "affiliation": "Amazon"}, {"name": "Nguyen, Tinh", "affiliation": "Amazon"}, {"name": "Luo, Xuewen", "affiliation": "Amazon"}, {"name": "Hoffmeister, Bj\u00f6rn", "affiliation": "Amazon"}, {"name": "Trmal, Jan", "affiliation": "Johns Hopkins University"}, {"name": "Omologo, Maurizio", "affiliation": "Amazon"}, {"name": "Maas, Roland", "affiliation": "Amazon"}], "contributors": [{"name": "Maas, Roland", "affiliation": "Amazon", "type": "ContactPerson"}, {"name": "Hoffmeister, Bj\u00f6rn", "affiliation": "Amazon", "type": "ContactPerson"}, {"name": "Yang, Chao-Han Huck", "affiliation": "Amazon", "type": "Distributor", "orcid": "0000-0003-2879-8811"}], "keywords": ["database", "noise robustness", "speaker separation", "distant speech recognition", "microphone array processing"], "language": "eng", "resource_type": {"title": "Dataset", "type": "dataset"}, "meeting": {"title": "Proc. Interspeech 2020"}, "license": {"id": "cdla-permissive-1.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "8122550"}}]}, "notes": "CDLA-Permissive license."}, "title": "DiPCo -- Dinner Party Corpus", "links": {"self": "https://zenodo.org/api/records/8122551", "self_html": "https://zenodo.org/records/8122551", "preview_html": "https://zenodo.org/records/8122551?preview=1", "doi": "https://doi.org/10.21437/Interspeech.2020-2800", "self_doi": "https://doi.org/10.21437/Interspeech.2020-2800", "self_doi_html": "https://zenodo.org/doi/10.21437/Interspeech.2020-2800", "reserve_doi": "https://zenodo.org/api/records/8122551/draft/pids/doi", "parent": "https://zenodo.org/api/records/8122550", "parent_html": "https://zenodo.org/records/8122550", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:8122551/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:8122551/sequence/default", "files": "https://zenodo.org/api/records/8122551/files", "media_files": "https://zenodo.org/api/records/8122551/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:8122551:van_segbroeck20_interspeech.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:8122551:van_segbroeck20_interspeech.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:8122551:van_segbroeck20_interspeech.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:8122551:van_segbroeck20_interspeech.pdf/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:8122551:van_segbroeck20_interspeech.pdf/full/%5E750,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record: