{
  "name": "pane-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Jali's lab: Data Studio and a loan review built on @jali/core and @jali/react (packages/). See docs/BRIEF.md.",
  "scripts": {
    "dev": "vite --port 5300 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:e2e": "playwright test",
    "screens": "SCREENS=1 playwright test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@jali/core": "workspace:*",
    "@jali/react": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
