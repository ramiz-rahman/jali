{
  "name": "jali",
  "version": "0.0.0",
  "private": true,
  "description": "Jali (@jali/core and @jali/react, in packages/), its docs site (apps/docs) and five example apps (examples/). See docs/BRIEF.md.",
  "type": "module",
  "scripts": {
    "dev": "vp dev examples/data-studio",
    "build": "tsc -b && vp build examples/data-studio && vp build examples/loan-review",
    "typecheck": "tsc -b --noEmit && tsc --noEmit -p apps/docs",
    "test": "vp test run && vp test run --config apps/docs/src/reference/vitest.config.ts && node scripts/agent-docs.mjs --check",
    "e2e": "playwright test",
    "test:e2e": "playwright test",
    "test:react18": "scripts/test-react18.sh",
    "screens": "SCREENS=1 playwright test",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "agent-docs": "node scripts/agent-docs.mjs",
    "icons": "node scripts/icons.mjs && vp fmt packages/react/src/icons/default-paths.ts",
    "size": "pnpm build:packages && tsc -p scripts/size && node scripts/size.mjs",
    "data-studio": "vp dev examples/data-studio",
    "loan-review": "vp dev examples/loan-review",
    "markets": "vp dev examples/markets",
    "studio": "vp dev examples/studio",
    "trips": "vp dev examples/trips",
    "minimal": "vp dev fixtures/minimal",
    "own-icons": "vp dev fixtures/own-icons"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@jali/core": "workspace:*",
    "@jali/react": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.107.1",
    "maplibre-gl": "^6.19.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "signalsmith-stretch": "1.3.2",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/chivo-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
