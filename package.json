{
  "name": "pane-lab",
  "version": "0.0.0",
  "private": true,
  "description": "Jali's lab: Data Studio and a loan review built on @jali/core and @jali/react (packages/). See docs/BRIEF.md.",
  "type": "module",
  "scripts": {
    "dev": "vp dev --port 5300 --strictPort",
    "build": "tsc -b && vp build",
    "typecheck": "tsc -b --noEmit",
    "test": "vp test run && vp test run --config apps/docs/src/reference/vitest.config.ts",
    "e2e": "playwright test",
    "test:e2e": "playwright test",
    "screens": "SCREENS=1 playwright test",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "example:minimal": "vp dev --config examples/minimal/vite.config.ts --port 5310",
    "example:bare-icons": "vp dev --config examples/bare-icons/vite.config.ts --port 5311"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@jali/core": "workspace:*",
    "@jali/react": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
