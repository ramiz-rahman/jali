{
  "name": "pane-lab",
  "version": "0.0.0",
  "private": true,
  "description": "Jali's lab: Data Studio and a loan review built on @jali/core and @jali/react (packages/). See docs/BRIEF.md.",
  "type": "module",
  "scripts": {
    "dev": "vp dev --port 5300 --strictPort",
    "build": "tsc -b && vp build",
    "typecheck": "tsc -b --noEmit && tsc --noEmit -p apps/docs",
    "test": "vp test run && vp test run --config apps/docs/src/reference/vitest.config.ts && node scripts/agent-docs.mjs --check",
    "e2e": "playwright test",
    "test:e2e": "playwright test",
    "test:react18": "scripts/test-react18.sh",
    "screens": "SCREENS=1 playwright test",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "agent-docs": "node scripts/agent-docs.mjs",
    "icons": "node scripts/icons.mjs && vp fmt packages/react/src/icons/default-paths.ts",
    "size": "pnpm build:packages && tsc -p scripts/size && node scripts/size.mjs",
    "example:minimal": "vp dev --config examples/minimal/vite.config.ts --port 5310",
    "example:own-icons": "vp dev --config examples/own-icons/vite.config.ts --port 5311",
    "example:markets": "vp dev --config examples/markets/vite.config.ts --port 5320"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@jali/core": "workspace:*",
    "@jali/react": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
