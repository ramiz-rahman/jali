---
/**
 * Everything a search engine or a link preview reads: the title, description, canonical address, social card and
 * structured data. Each page is its own HTML file, so all of it is right for the page it is in. A page that isn't
 * indexed (the 404, a draft) has no canonical address and no Markdown copy.
 */
import { AUTHOR, LICENSE, REPO_URL, SITE_NAME } from "../site/config";
import { markdownUrl } from "../site/sources";

export interface Props {
  /** The document's title, the site's name in it. */
  title: string;
  /** What the page is called on its own: an article's headline. */
  headline: string;
  description: string;
  path: string;
  noindex?: boolean;
  breadcrumbs?: { name: string; path: string }[];
  /** When the page last changed (an ISO date, src/site/last-modified.mjs), when known. */
  modified?: string;
}
const { title, headline, description, path, noindex, breadcrumbs, modified } = Astro.props;
const site = Astro.site!;
const canonical = new URL(path, site).href;
const image = new URL("/jali-social.png", site).href;
const home = new URL("/", site).href;
const author = { "@type": "Person", name: AUTHOR.name, url: AUTHOR.url };
const ld = [
  ...(path === "/"
    ? [
        { "@context": "https://schema.org", "@type": "WebSite", name: SITE_NAME, url: home, description },
        // What the site is about, for search and answer engines: the library itself, its code and its terms.
        {
          "@context": "https://schema.org",
          "@type": "SoftwareSourceCode",
          name: SITE_NAME,
          description,
          url: home,
          codeRepository: REPO_URL,
          programmingLanguage: "TypeScript",
          runtimePlatform: ["React", "Web browser"],
          license: LICENSE.url,
          author,
        },
      ]
    : [
        {
          "@context": "https://schema.org",
          "@type": "TechArticle",
          headline,
          description,
          url: canonical,
          ...(modified ? { dateModified: modified } : {}),
          author,
          isPartOf: { "@type": "WebSite", name: SITE_NAME, url: home },
        },
      ]),
  ...(breadcrumbs && breadcrumbs.length > 1
    ? [
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          itemListElement: breadcrumbs.map((b, i) => ({
            "@type": "ListItem",
            position: i + 1,
            name: b.name,
            ...(b.path ? { item: new URL(b.path, site).href } : {}),
          })),
        },
      ]
    : []),
];
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<link rel="sitemap" href="/sitemap-index.xml" />
{noindex ? null : <link rel="alternate" type="text/markdown" href={markdownUrl(path)} title="This page as Markdown" />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta property="og:type" content={path === "/" ? "website" : "article"} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="theme-color" content="#f7f5f1" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#13120f" media="(prefers-color-scheme: dark)" />
<script type="application/ld+json" set:html={JSON.stringify(ld.length === 1 ? ld[0] : ld)} />
