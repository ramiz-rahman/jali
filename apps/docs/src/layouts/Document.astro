---
/**
 * Every page's document: the head, the reader's theme and code-wrap choice applied before the first paint, the
 * site's one stylesheet, and the one small script that makes the static page work (src/client/enhance.ts).
 */
import Head from "./Head.astro";
import "@jali/react/styles.css";
import "../styles/site.css";
import "../live/live.css";
import "../reference/reference.css";
// The faces the first screen of any page uses, fetched with the HTML instead of after the CSS, so text is drawn
// once in its own font and doesn't move when the font arrives. The same files the stylesheet names.
import text400 from "@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-400-normal.woff2?url";
import text500 from "@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-500-normal.woff2?url";
import text600 from "@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-600-normal.woff2?url";
import mono400 from "@fontsource/atkinson-hyperlegible-mono/files/atkinson-hyperlegible-mono-latin-400-normal.woff2?url";
const fonts = [text400, text500, text600, mono400];
type Props = import("./Head.astro").Props;
const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Layer order first: the docs page resets, then Jali, then the docs' own styles. -->
    <style is:inline>
      @layer docs-base, jali, docs;
    </style>
    <!--
      Before the first paint: data-theme is the resolved theme, as @jali/core sets it (src/client/enhance.ts keeps it
      current); data-theme-choice lights the toggle's button; data-code-wrap wraps long code lines.
    -->
    <script is:inline>
      (function () {
        var c = "system",
          w = null;
        try {
          c = localStorage.getItem("jali-docs-theme") || "system";
          w = localStorage.getItem("jali-docs-code-wrap");
        } catch (e) {}
        var dark =
          c === "dark" ||
          (c !== "light" && window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches);
        var root = document.documentElement;
        root.setAttribute("data-theme", dark ? "dark" : "light");
        root.setAttribute("data-theme-choice", c === "light" || c === "dark" ? c : "system");
        if (w === "1") root.setAttribute("data-code-wrap", "");
      })();
    </script>
    <Head {...props} />
    {fonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
  </head>
  <body>
    <div id="root"><slot /></div>
    <script>
      import "../client/enhance";
    </script>
  </body>
</html>
