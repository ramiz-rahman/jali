---
interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  breadcrumbs?: { name: string; path: string }[];
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Layer order first: the docs page resets, then Jali, then the docs' own styles. -->
    <style is:inline>
      @layer docs-base, jali, docs;
    </style>
    <!-- The theme before the first paint: data-theme is the resolved theme, as @jali/core sets it (src/site/theme.ts). -->
    <script is:inline>
      (function () {
        var c = "system";
        try {
          c = localStorage.getItem("jali-docs-theme") || "system";
        } catch (e) {}
        var dark =
          c === "dark" ||
          (c !== "light" && window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.setAttribute("data-theme", dark ? "dark" : "light");
        document.documentElement.setAttribute(
          "data-theme-choice",
          c === "light" || c === "dark" ? c : "system",
        );
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <div id="root"><slot /></div>
  </body>
</html>
