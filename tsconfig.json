{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "customConditions": ["source"],
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "types": ["vitest/globals"],
    // The examples' shared module, as package.json "imports" names it for Vite (TypeScript doesn't add extensions there).
    "paths": { "#shared/*": ["./examples/shared/src/*"] }
  },
  "include": ["tests", "e2e", "packages/*/src", "examples/*/src", "fixtures/*/src"]
}
