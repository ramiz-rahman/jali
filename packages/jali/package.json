{
  "name": "jali",
  "version": "0.0.0",
  "description": "A new layout primitive for React apps. Split any part of your app into adaptive tiling panes, from two side by side to over a dozen in rows, columns and tabs. You describe each pane once; your users arrange them the way they work, on any screen. A framework-free core, with React components and hooks.",
  "keywords": [
    "docking-layout",
    "layout",
    "layout-manager",
    "panes",
    "react",
    "resizable-panels",
    "split view",
    "split-pane",
    "tabs",
    "tiling",
    "tiling-window-manager",
    "workspace"
  ],
  "homepage": "https://jali.ramizrahman.com",
  "bugs": {
    "url": "https://github.com/ramiz-rahman/jali/issues"
  },
  "license": "Apache-2.0",
  "author": "Ramiz Rahman (https://ramizrahman.com/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramiz-rahman/jali.git",
    "directory": "packages/jali"
  },
  "files": [
