{
  "name": "@jali/core",
  "version": "0.0.0",
  "description": "Jali's framework-free core: a layout tree of panes that fits the space it has, a workspace store with undo, focus and follow, keyboard commands, and ports for the URL and storage.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "source": "./src/adapter.ts",
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js",
      "default": "./dist/adapter.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown"
  }
}
