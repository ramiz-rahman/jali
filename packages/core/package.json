{
  "name": "@jali/core",
  "version": "0.0.0",
  "private": true,
  "description": "Jali's framework-free core, as a workspace package: published as `jali` (packages/jali). Kept for Data Studio's link until it moves to `jali`.",
  "license": "Apache-2.0",
  "author": "Ramiz Rahman (https://ramizrahman.com/)",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "source": "./src/adapter.ts",
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js",
      "default": "./dist/adapter.js"
    },
    "./agent": {
      "source": "./src/agent.ts",
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js",
      "default": "./dist/agent.js"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./adapter": {
        "types": "./dist/adapter.d.ts",
        "import": "./dist/adapter.js",
        "default": "./dist/adapter.js"
      },
      "./agent": {
        "types": "./dist/agent.d.ts",
        "import": "./dist/agent.js",
        "default": "./dist/agent.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js",
        "default": "./dist/testing.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp pack"
  }
}
