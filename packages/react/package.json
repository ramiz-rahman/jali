{
  "name": "@jali/react",
  "version": "0.0.0",
  "description": "React components and hooks for Jali workspaces, with Jali's default theme and a bridge to a Tailwind theme.",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bare": {
      "source": "./src/bare.ts",
      "types": "./dist/bare.d.ts",
      "import": "./dist/bare.js",
      "default": "./dist/bare.js"
    },
    "./icons": {
      "source": "./src/icons.ts",
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "default": "./dist/icons.js"
    },
    "./styles.css": {
      "source": "./src/styles/index.css",
      "style": "./src/styles/index.css",
      "default": "./dist/styles.css"
    },
    "./theme.css": {
      "source": "./src/styles/jali-theme.css",
      "style": "./src/styles/jali-theme.css",
      "default": "./dist/theme.css"
    },
    "./tailwind.css": {
      "source": "./src/styles/jali-tailwind.css",
      "style": "./src/styles/jali-tailwind.css",
      "default": "./dist/tailwind.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./bare": {
        "types": "./dist/bare.d.ts",
        "import": "./dist/bare.js",
        "default": "./dist/bare.js"
      },
      "./icons": {
        "types": "./dist/icons.d.ts",
        "import": "./dist/icons.js",
        "default": "./dist/icons.js"
      },
      "./styles.css": {
        "default": "./dist/styles.css"
      },
      "./theme.css": {
        "default": "./dist/theme.css"
      },
      "./tailwind.css": {
        "default": "./dist/tailwind.css"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp pack"
  },
  "dependencies": {
    "@jali/core": "workspace:*"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10"
  },
  "peerDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@phosphor-icons/react": {
      "optional": true
    }
  }
}
