{
  "name": "@jali/react",
  "version": "0.0.0",
  "private": true,
  "description": "Jali's React components and hooks, as a workspace package: published as `jali/react` and the feature entries (packages/jali). Kept for Data Studio's link until it moves to `jali`.",
  "license": "Apache-2.0",
  "author": "Ramiz Rahman (https://ramizrahman.com/)",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./icons": {
      "source": "./src/icons.ts",
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "default": "./dist/icons.js"
    },
    "./styles.css": {
      "source": "./src/styles/index.css",
      "style": "./src/styles/index.css",
      "default": "./dist/styles.css"
    },
    "./theme.css": {
      "source": "./src/styles/jali-theme.css",
      "style": "./src/styles/jali-theme.css",
      "default": "./dist/theme.css"
    },
    "./tailwind.css": {
      "source": "./src/styles/jali-tailwind.css",
      "style": "./src/styles/jali-tailwind.css",
      "default": "./dist/tailwind.css"
    },
    "./internal": {
      "source": "./src/internal.ts",
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "default": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./icons": {
        "types": "./dist/icons.d.ts",
        "import": "./dist/icons.js",
        "default": "./dist/icons.js"
      },
      "./styles.css": {
        "default": "./dist/styles.css"
      },
      "./theme.css": {
        "default": "./dist/theme.css"
      },
      "./tailwind.css": {
        "default": "./dist/tailwind.css"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "import": "./dist/internal.js",
        "default": "./dist/internal.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp pack"
  },
  "dependencies": {
    "@jali/core": "workspace:*"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@testing-library/react": "^16.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}
